# Vite 开发环境（loadEnv 会注入 process.env）
BROWSER=false
OPEN=false
PORT=4000
PUBLIC_URL=/
NODE_ENV=development
# 开发时 /api 代理目标（见 vite.config.mjs server.proxy）
VITE_DEV_API_PROXY=http://127.0.0.1:3001
# 生产构建用 API 根路径（开发态 axios 固定走 /api）
VITE_BASE_URL=
VITE_UPLOAD_URL=
VITE_STATIC_BASE_API=
# 兼容历史 CRA 变量名（逐步废弃）
REACT_APP_BASE_URL=
REACT_APP_UPLOAD_URL=
REACT_APP_STATIC_BASE_API=
